# Stripe (test mode). Copy to .env.local and fill in values from
# https://dashboard.stripe.com/test/apikeys
#
# Without STRIPE_SECRET_KEY the app keeps the demo (non-Stripe) payment path
# so local/CI e2e continues to work.

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MongoDB Atlas (optional for local/CI).
# Without MONGODB_URI the API uses an in-memory store so tests still run.
# With Atlas: Network Access → allow your IP (or 0.0.0.0/0 for local demo).

MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shifty

# HubSpot CRM (optional). Private app token from Settings → Integrations →
# Private Apps, with scopes crm.objects.contacts.read + crm.objects.contacts.write
# + crm.objects.deals.read + crm.objects.deals.write (add crm.schemas.contacts.write
# and crm.schemas.deals.write to run scripts/hubspot-setup.mjs).
# Without it, the HubSpot sync is skipped.
HUBSPOT_ACCESS_TOKEN=pat-...
# Optional: pipeline and closed-won stage IDs for registration deals
# (defaults: the "default" pipeline's "closedwon" stage).
# HUBSPOT_DEAL_PIPELINE=
# HUBSPOT_DEAL_STAGE=
