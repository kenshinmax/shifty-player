# Stripe (test mode). Copy to .env.local and fill in values from
# https://dashboard.stripe.com/test/apikeys
#
# Without STRIPE_SECRET_KEY the app keeps the demo (non-Stripe) payment path
# so local/CI e2e continues to work.

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Async payment verification worker (lib/payment-verification.ts).
# Poll interval, retry backoff base, and max attempts before a verification
# is marked failed (retryable via POST /api/payments/[id]/retry).
# PAYMENT_VERIFICATION_POLL_MS=2000
# PAYMENT_VERIFICATION_BACKOFF_MS=2000
# PAYMENT_VERIFICATION_MAX_ATTEMPTS=5

# MongoDB Atlas (optional for local/CI).
# Without MONGODB_URI the API uses an in-memory store so tests still run.
# With Atlas: Network Access → allow your IP (or 0.0.0.0/0 for local demo).

MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shifty

# HubSpot CRM (optional). Private app token from Settings → Integrations →
# Private Apps, with scopes crm.objects.contacts.read + crm.objects.contacts.write
# + crm.objects.deals.read + crm.objects.deals.write (add crm.schemas.contacts.write
# and crm.schemas.deals.write to run scripts/hubspot-setup.mjs).
# Without it, the HubSpot sync is skipped.
HUBSPOT_ACCESS_TOKEN=pat-...
# Optional: pipeline and closed-won stage IDs for registration deals
# (defaults: the "default" pipeline's "closedwon" stage).
# HUBSPOT_DEAL_PIPELINE=
# HUBSPOT_DEAL_STAGE=

# OpenTelemetry → Splunk (lib/otel.ts; see documentation/planned/otel-splunk-implementation-plan.md).
# Telemetry is disabled unless OTEL_ENABLED=true AND OTEL_EXPORTER_OTLP_ENDPOINT are set.
# Production-only at launch: leave OTEL_ENABLED=false locally.
# The endpoint points at the Splunk OTel Collector gateway, which holds the
# Splunk HEC token — the app itself stores no Splunk secret.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=shifty-player
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Sampling ratio for production (1 = keep everything).
OTEL_TRACES_SAMPLER_ARG=1
